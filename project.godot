; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="PixelKing"
config/description="像素风格国际象棋Roguelike (仿衔尾蛇国王 The Ouroboros King)"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PieceSkinManager="*res://scripts/autoload/PieceSkinManager.gd"
Localization="*res://scripts/autoload/Localization.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
GameState="*res://scripts/autoload/GameState.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
RunManager="*res://scripts/autoload/RunManager.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/themes/pixel_king_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
