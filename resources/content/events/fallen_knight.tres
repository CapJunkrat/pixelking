options = Array[Dictionary]([{"id": "tend", "label": "Tend his wounds", "detail": "A Knight joins your army.", "cost": 12, "kind": "piece", "piece_def_id": "knight", "success_text": "He rises, bows to your King, and joins your army."}, {"id": "sword", "label": "Take his sword", "detail": "70%: take {reward}. 30%: his squire chases you off (lose 5 Gold).", "kind": "random_item", "chance": 0.7, "fail": {"kind": "lose_gold", "amount": 5}, "success_text": "You take %s.", "fail_text": "His squire chases you off. You drop 5 Gold."}, {"id": "leave", "label": "Walk on", "detail": "Nothing happens.", "kind": "nothing", "success_text": "You say a prayer and move on."}])
min_layer = 0
sky_top = Color(0.1647, 0.1647, 0.2667, 1)
sky_bottom = Color(0.4784, 0.2902, 0.3529, 1)
