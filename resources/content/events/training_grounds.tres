[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/EventDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"training_grounds"
title = "Training Grounds"
description = "An abandoned drill yard. Straw dummies still stand in neat rows."
safe_gold = 12
risky_gold = 25
can_offer_relic = true
options = Array[Dictionary]([{"id": "drill", "label": "Drill your {target}", "detail": "Your {target} trains: one capture closer to its next form.", "kind": "train_best", "success_text": "Your {target} grows sharper."}, {"id": "spar", "label": "Spar without mercy", "detail": "60%: your {target} trains twice. 40%: it limps off and you pay a 10 Gold healer.", "kind": "train_best", "times": 2, "chance": 0.6, "fail": {"kind": "lose_gold", "amount": 10}, "success_text": "Bruised but brilliant: two drills in one day.", "fail_text": "Too hard, too fast. The healer charges 10 Gold."}, {"id": "tourney", "label": "Host a small tourney", "detail": "Gain 20 Gold from the onlookers.", "kind": "gold", "amount": 20, "success_text": "The crowd pays 20 Gold to watch."}])
min_layer = 0
sky_top = Color(0.1412, 0.2510, 0.4157, 1)
sky_bottom = Color(0.5412, 0.6588, 0.7529, 1)
glow = Color(0.9608, 0.8353, 0.5608, 1)
props = Array[String](["banner", "piece:squire", "piece:pawn"])
