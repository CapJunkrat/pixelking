[resource]
script = ExtResource("1_script")
id = &"ancient_shrine"
title = "Ancient Shrine"
description = "Moss-covered stones hum faintly. Something old is listening."
safe_gold = 12
risky_gold = 25
can_offer_relic = true
options = Array[Dictionary]([{"id": "pray", "label": "Pray at the altar", "detail": "60%: receive {reward}. 40%: lose 10 Gold.", "kind": "random_relic", "chance": 0.6, "fail": {"kind": "lose_gold", "amount": 10}, "success_text": "The shrine grants you %s.", "fail_text": "The shrine stays silent. You lose 10 Gold on the way out."}, {"id": "offering", "label": "Leave an offering", "detail": "Restore your retry.", "cost": 20, "kind": "restore_retry", "success_text": "Warmth fills your ranks. Your retry is restored."}, {"id": "leave", "label": "Walk on", "detail": "Nothing happens.", "kind": "nothing", "success_text": "You leave the shrine in peace."}])
min_layer = 0
sky_top = Color(0.0431, 0.0784, 0.1882, 1)
sky_bottom = Color(0.1216, 0.2902, 0.3529, 1)
glow = Color(0.4314, 0.9412, 0.8784, 1)
props = Array[String](["altar"])
