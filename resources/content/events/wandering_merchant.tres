[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/EventDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"wandering_merchant"
title = "Wandering Merchant"
description = "A cart of curiosities rattles up the road. The merchant grins and taps a sealed crate."
safe_gold = 12
risky_gold = 25
can_offer_relic = true
options = Array[Dictionary]([{"id": "crate", "label": "Buy a sealed crate", "detail": "Inside: {reward}.", "cost": 15, "kind": "random_item", "success_text": "Inside the crate: %s."}, {"id": "sellsword", "label": "Hire a sellsword", "detail": "{reward} joins your army.", "cost": 30, "kind": "random_piece", "pool": "rare", "success_text": "%s joins your army."}, {"id": "trinkets", "label": "Sell old trinkets", "detail": "Gain 10 Gold.", "kind": "gold", "amount": 10, "success_text": "The merchant pays 10 Gold."}])
min_layer = 0
sky_top = Color(0.1137, 0.1020, 0.2275, 1)
sky_bottom = Color(0.6588, 0.3412, 0.2275, 1)
glow = Color(1.0000, 0.7020, 0.4196, 1)
props = Array[String](["cart", "enemy:pawn", "chest"])
