[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/EventDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"wandering_merchant"
title = "Wandering Merchant"
description = "A cart of curiosities rattles up the road. The merchant grins and opens a crate."
options = Array[Dictionary]([{"id": "crate", "label": "Buy a sealed crate", "detail": "A random battle item, sight unseen.", "cost": 15, "kind": "random_item", "success_text": "Inside the crate: %s."}, {"id": "sellsword", "label": "Hire a sellsword", "detail": "A rare piece joins your army.", "cost": 30, "kind": "random_piece", "pool": "rare", "success_text": "%s joins your army."}, {"id": "trinkets", "label": "Sell old trinkets", "detail": "Gain 10 Gold.", "kind": "gold", "amount": 10, "success_text": "The merchant pays 10 Gold."}])
safe_gold = 12
risky_gold = 25
can_offer_relic = true
