[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/EventDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"golden_fork"
title = "Golden Fork"
description = "The road splits. One way is paved; the other vanishes into ruins."
safe_gold = 12
risky_gold = 25
can_offer_relic = true
options = Array[Dictionary]([{"id": "paved", "label": "Take the paved road", "detail": "Gain 15 Gold.", "kind": "gold", "amount": 15, "success_text": "An easy march. You find 15 Gold."}, {"id": "overgrown", "label": "Take the overgrown path", "detail": "50%: gain 45 Gold. 50%: nothing.", "kind": "gold", "amount": 45, "chance": 0.5, "fail": {"kind": "nothing"}, "success_text": "Hidden treasure: 45 Gold!", "fail_text": "Only brambles. You find nothing."}, {"id": "ruins", "label": "Search the ruins", "detail": "50%: find {reward}. 50%: lose 8 Gold.", "kind": "random_item", "chance": 0.5, "fail": {"kind": "lose_gold", "amount": 8}, "success_text": "Among the ruins: %s.", "fail_text": "A trap! You lose 8 Gold."}])
min_layer = 0
sky_top = Color(0.1647, 0.2902, 0.4784, 1)
sky_bottom = Color(0.8784, 0.6588, 0.3608, 1)
glow = Color(1.0000, 0.8863, 0.5608, 1)
props = Array[String](["signpost"])
