[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/EventDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"lost_patrol"
title = "Lost Patrol"
description = "A ragged patrol has lost its captain. They eye your banner hopefully."
safe_gold = 12
risky_gold = 25
can_offer_relic = true
options = Array[Dictionary]([{"id": "recruit", "label": "Take them in", "detail": "{reward} joins your army.", "kind": "random_piece", "pool": "common", "success_text": "%s joins your army."}, {"id": "supplies", "label": "Trade supplies", "detail": "Gain 18 Gold.", "kind": "gold", "amount": 18, "success_text": "They pay 18 Gold for your supplies."}, {"id": "rob", "label": "Shake them down", "detail": "Gain 35 Gold. 40%: one of your pieces deserts in disgust.", "kind": "gold", "amount": 35, "chance": 0.6, "fail": {"kind": "gold_and_desert", "amount": 35}, "success_text": "You take 35 Gold.", "fail_text": "You take 35 Gold, but %s deserts."}])
min_layer = 0
sky_top = Color(0.1020, 0.0863, 0.1882, 1)
sky_bottom = Color(0.3529, 0.2275, 0.2275, 1)
glow = Color(1.0000, 0.6039, 0.2980, 1)
props = Array[String](["campfire", "piece:pawn", "piece:pawn", "piece:pawn"])
