[gd_resource type="Resource" script_class="ShopPoolDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/ShopPoolDef.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"standard_shop"
title = "Royal Market"
description = "Purchase one offer or leave. Inventory is fixed for this visit."
