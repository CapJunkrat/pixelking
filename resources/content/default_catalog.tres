fusion_recipes = Array[Resource]([ExtResource("16_recipe_lancer"), ExtResource("17_recipe_archmage")])
challenger_items = Array[Resource]([ExtResource("18_item_crown"), ExtResource("19_item_coin"), ExtResource("20_item_banner"), ExtResource("21_item_feather"), ExtResource("22_item_bomb")])
battle_reward_table = ExtResource("23_reward")
