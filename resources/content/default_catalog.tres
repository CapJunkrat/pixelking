map_node_defs = Array[Resource]([ExtResource("30_node_normal"), ExtResource("31_node_elite"), ExtResource("32_node_shop"), ExtResource("33_node_event"), ExtResource("34_node_rest"), ExtResource("35_node_boss")])
map_templates = Array[Resource]([ExtResource("36_map_standard")])
