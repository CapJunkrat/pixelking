[sub_resource type="Resource" id="SlideRule"]
script = ExtResource("3_slide")
directions = Array[Vector2i]([Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)])
max_distance = 8

[sub_resource type="Resource" id="JumpRule"]
script = ExtResource("4_jump")
offsets = Array[Vector2i]([Vector2i(1, 2), Vector2i(2, 1), Vector2i(2, -1), Vector2i(1, -2), Vector2i(-1, -2), Vector2i(-2, -1), Vector2i(-2, 1), Vector2i(-1, 2)])

[sub_resource type="Resource" id="MovementProfile"]
script = ExtResource("2_profile")
