[ext_resource type="Resource" path="res://resources/content/motion_profiles/knight.tres" id="5_motion"]

[sub_resource type="Resource" id="JumpRule"]
script = ExtResource("3_jump")
offsets = Array[Vector2i]([Vector2i(1, 2), Vector2i(2, 1), Vector2i(2, -1), Vector2i(1, -2), Vector2i(-1, -2), Vector2i(-2, -1), Vector2i(-2, 1), Vector2i(-1, 2)])

[sub_resource type="Resource" id="SlideRule"]
script = ExtResource("4_slide")
