[gd_resource type="Resource" script_class="PieceDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/PieceDef.gd" id="1_piece"]
[ext_resource type="Script" path="res://scripts/core/movement/MovementProfile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/core/movement/SlideMovementRule.gd" id="3_slide"]
[ext_resource type="Script" path="res://scripts/core/movement/CastlingMovementRule.gd" id="4_castling"]
[ext_resource type="Resource" path="res://resources/content/motion_profiles/king.tres" id="5_motion"]

[sub_resource type="Resource" id="SlideRule"]
script = ExtResource("3_slide")
directions = Array[Vector2i]([Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1), Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)])
max_distance = 1

[sub_resource type="Resource" id="MovementProfile"]
script = ExtResource("2_profile")
rules = Array[Resource]([SubResource("SlideRule")])

[sub_resource type="Resource" id="CastlingRule"]
script = ExtResource("4_castling")
partner_piece_ids = Array[StringName]([&"rook"])

[resource]
script = ExtResource("1_piece")
id = "king"
display_name_key = &"PIECE_KING"
movement_profile = SubResource("MovementProfile")
motion_profile = ExtResource("5_motion")
special_move_rules = Array[Resource]([SubResource("CastlingRule")])
is_royal = true
is_king = true
base_value = 1000
rarity = 0
available_in_opening_draft = false
opening_draft_weight = 0
