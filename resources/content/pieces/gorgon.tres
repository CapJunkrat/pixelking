[ext_resource type="Resource" path="res://resources/content/motion_profiles/queen.tres" id="4_motion"]

[sub_resource type="Resource" id="SlideRule"]
script = ExtResource("3_slide")
directions = Array[Vector2i]([Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)])
max_distance = 8
allow_captures = false

[sub_resource type="Resource" id="BiteRule"]
script = ExtResource("3_slide")
directions = Array[Vector2i]([Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1), Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)])
min_distance = 1
max_distance = 1
allow_captures = true
allow_empty_destinations = false

[sub_resource type="Resource" id="MovementProfile"]
script = ExtResource("2_profile")
rules = Array[Resource]([SubResource("SlideRule"), SubResource("BiteRule")])

[resource]
