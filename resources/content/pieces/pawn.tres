[gd_resource type="Resource" script_class="PieceDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/PieceDef.gd" id="1_piece"]
[ext_resource type="Script" path="res://scripts/core/movement/MovementProfile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/core/movement/PawnMovementRule.gd" id="3_rule"]
[ext_resource type="Resource" path="res://resources/content/motion_profiles/pawn.tres" id="4_motion"]

[sub_resource type="Resource" id="PawnRule"]
script = ExtResource("3_rule")

[sub_resource type="Resource" id="MovementProfile"]
script = ExtResource("2_profile")
rules = Array[Resource]([SubResource("PawnRule")])

[resource]
script = ExtResource("1_piece")
id = "pawn"
display_name_key = &"PIECE_PAWN"
movement_profile = SubResource("MovementProfile")
motion_profile = ExtResource("4_motion")
is_pawn = true
base_value = 1
rarity = 0
available_in_opening_draft = true
opening_draft_weight = 4
